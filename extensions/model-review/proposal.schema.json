{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "models": {
      "minItems": 1,
      "maxItems": 40,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,79}$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "fields": {
            "minItems": 1,
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_]{0,79}$"
                },
                "type": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 12000
                },
                "required": {
                  "type": "boolean"
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 12000
                },
                "storage": {
                  "type": "string",
                  "enum": [
                    "stored",
                    "derived"
                  ]
                },
                "mutability": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 12000
                },
                "constraints": {
                  "maxItems": 100,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 12000
                  }
                }
              },
              "required": [
                "name",
                "type",
                "required",
                "description",
                "storage",
                "mutability",
                "constraints"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "name",
          "description",
          "fields"
        ],
        "additionalProperties": false
      }
    },
    "relationships": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,79}$"
          },
          "to": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,79}$"
          },
          "cardinality": {
            "type": "string",
            "enum": [
              "one-to-one",
              "one-to-many",
              "one-to-zero-or-many",
              "many-to-many"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          }
        },
        "required": [
          "from",
          "to",
          "cardinality",
          "description"
        ],
        "additionalProperties": false
      }
    },
    "lifecycle": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 12000
      }
    },
    "invariants": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 12000
      }
    },
    "migration": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 12000
      }
    },
    "assumptions": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 12000
      }
    },
    "questions": {
      "maxItems": 40,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,79}$"
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "options": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 12000
            }
          },
          "recommended": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          }
        },
        "required": [
          "id",
          "prompt"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "title",
    "summary",
    "models",
    "relationships",
    "lifecycle",
    "invariants",
    "migration",
    "assumptions",
    "questions"
  ],
  "additionalProperties": false
}
